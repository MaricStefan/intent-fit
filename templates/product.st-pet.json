    "faq": {
      "type": "st_faq-and-text",
      "blocks": {
        "q1": {
          "type": "faq_item",
          "settings": {
            "question": "What if my dog spits it out anyway?",
            "answer": "<p>That is the one thing we designed against, and 96% of dogs in our feeding trial took the first chew without any persuasion. If yours is in the other 4%, email us inside 60 days and we refund the tin, half eaten and all.</p>"
          }
        },
        "q2": {
          "type": "faq_item",
          "settings": {
            "question": "How many chews a day, and does size matter?",
            "answer": "<p>Two a day for every dog, puppies through to gentle giants. The dose is set for the smallest eater so there is no chart to read and nothing to cut in half. Sixty chews in a tin means exactly thirty days.</p>"
          }
        },
        "q3": {
          "type": "faq_item",
          "settings": {
            "question": "What is actually in it?",
            "answer": "<p>Two actives. A live probiotic blend for the gut flora, and pumpkin for fibre. No grain filler, no artificial colour, no sugar coating to force palatability. The soft chew texture is what makes them take it.</p>"
          }
        },
        "q4": {
          "type": "faq_item",
          "settings": {
            "question": "How long before we see a difference?",
            "answer": "<p>Most owners report firmer stools inside the first week and a settled stomach by week two or three. Give it the full tin before you judge it. That is the thirty days a gut needs to actually turn over.</p>"
          }
        },
        "q5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I still hide it in food if I want to?",
            "answer": "<p>You can, but you almost certainly will not need to. The whole point is that it goes down as a treat from your hand, so nothing gets nosed around the bowl and left there until Friday.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ],
