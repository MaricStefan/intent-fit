        {% endif %}
        border-radius: {{ block.settings.icon_border_radius }}px;
        display: flex;
        align-items: center;
        justify-content: center;
        {% if block.settings.enable_hover_effects %}
        transition: all 0.3s ease;
        {% endif %}
      }

      {% if block.settings.enable_hover_effects %}
      .st_footer-section-{{ section.id }} .st_footer-social-media-{{ block.id }} .st_footer-social-icon:hover {
        background-color: {{ block.settings.icon_hover_bg_color }};
        transform: translateY(-2px);
      }
      {% endif %}

      .st_footer-section-{{ section.id }} .st_footer-social-media-{{ block.id }} .st_footer-social-icon svg {
        width: {{ block.settings.icon_size | divided_by: 2 }}px;
        height: {{ block.settings.icon_size | divided_by: 2 }}px;
        fill: {{ block.settings.icon_color }};
        {% if block.settings.enable_hover_effects %}
        transition: fill 0.3s ease;
        {% endif %}
      }

      {% if block.settings.enable_hover_effects %}
      .st_footer-section-{{ section.id }} .st_footer-social-media-{{ block.id }} .st_footer-social-icon:hover svg {
        fill: {{ block.settings.icon_hover_color }};
      }
      {% endif %}

      @media (max-width: 768px) {
        .st_footer-section-{{ section.id }} .st_footer-social-media-{{ block.id }} h3 {
          font-size: {{ block.settings.mobile_title_size }}px;
        }
      }
    {% endif %}
  {% endfor %}

  /* Footer Block Styles (Combined Copyright & Payment Methods) */
  {% for block in section.blocks %}
