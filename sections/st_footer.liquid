<script
  src="https://app.sternify.com/verifier.js?v={{ 'now' | date: '%s' }}"
  data-section-id="{{ section.id }}"
  defer
></script>

<div id="st_not-found--{{ section.id }}" class="st_not-found" style="display: none;"></div>

<style>
  /* BFC gegen Margin-Collapsing mit Nachbar-Sections (Standard Regel 3) */
  #shopify-section-{{ section.id }} {
    display: flow-root;
    background-color: {{ section.settings.section_background_color }};
    padding-top: {{ section.settings.margin_top }}px;
  }

  .st_footer-section-{{ section.id }} div:empty {
    display: unset !important;
  }

  /* ── Counter st_reset.css to allow richtext styling ── */
  .st_footer-section-{{ section.id }} :is(strong, b),
  .st_footer-section-{{ section.id }} :is(strong, b) * {
    font-weight: bold !important;
    font-family: inherit;
    color: inherit;
    font-style: inherit;
  }

  .st_footer-section-{{ section.id }} :is(em, i),
  .st_footer-section-{{ section.id }} :is(em, i) * {
    font-style: italic !important;
    font-family: inherit;
    color: inherit;
    font-weight: inherit;
  }

  .st_footer-section-{{ section.id }} span {
    font-size: inherit;
    font-family: inherit;
    color: inherit;
    font-style: inherit;
    font-weight: inherit;
  }
  /* --- */

  .st_footer-section-{{ section.id }} {
    width: 100%;
    {% unless section.settings.full_width %}
    padding-inline: 15px;
    {% endunless %}
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .st_footer-section_wrapper-{{ section.id }} {
    display: flex;
    {% unless section.settings.full_width %}
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    {% endunless %}
    background: {{ section.settings.section_bg_color }};
    justify-content: center;
    height: 100%;
    {% unless section.settings.full_width %}
    border-radius: 20px;
    {% endunless %}
    overflow: hidden;
  }

  .st_footer-wrapper-{{ section.id }} {
    {% if section.settings.full_width %}
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-inline: 45px;
    {% else %}
    max-width: {{ section.settings.max_width }}px;
    {% endif %}
    padding: 40px 40px 20px 40px;
  }

  .st_footer-newsletter-container-{{ section.id }} {
    width: 100%;
    margin-bottom: 40px;
  }

  .st_footer-main-content-{{ section.id }} {
    display: grid;
    grid-template-columns: none;
    grid-auto-flow: column;
    gap: 40px;
    margin-bottom: 40px;
  }

  .st_footer-bottom-{{ section.id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  @media (max-width: 1000px) {

    .st_footer-section-{{ section.id }} {
        padding-inline: 0px;
    }

    .st_footer-section_wrapper-{{ section.id }} {
        max-width: 100%;
        border-radius: 0px;
    }
  }

  /* Newsletter Block Styles */
  {% for block in section.blocks %}
    {% if block.type == 'newsletter' %}
      {{ block.settings.title_font | font_face }}
      {{ block.settings.description_font | font_face }}

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 40px;
        {% if block.settings.newsletter_br %}
        border-bottom: 1px solid {{ block.settings.newsletter_border_color }};
        {% endif %}
      }

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-text-content {
        display: flex;
        flex-direction: column;
        text-align: left;
      }

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-form-container {
        display: flex;
        justify-content: flex-start;
      }

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-title {
        font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
        font-size: {{ block.settings.title_size }}px;
        color: {{ block.settings.title_color }};
        font-style: {{ block.settings.title_font.style }};
        font-weight: {{ block.settings.title_font.weight }};
        margin-bottom: 15px;
      }

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-description {
        font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
        font-size: {{ block.settings.description_size }}px;
        color: {{ block.settings.description_color }};
        font-style: {{ block.settings.description_font.style }};
        font-weight: {{ block.settings.description_font.weight }};
        margin-bottom: 20px;
        line-height: 1.5;
      }

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-form {
        display: flex;
        gap: 15px;
        align-items: stretch;
        width: 100%;
      }

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-input {
        padding: 12px 16px;
        border: 1px solid {{ block.settings.input_border_color }};
        border-radius: {{ block.settings.form_border_radius }}px;
        background-color: {{ block.settings.input_bg_color }};
        color: {{ block.settings.input_text_color }};
        font-size: 14px;
        flex: 1 0 0px;
      }

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-input:focus {
        outline: none;
        outline-offset: 0 !important;
        outline-width: 0 !important;
        box-shadow: none;
        border: 2px solid {{ block.settings.input_border_color }} !important;
      }

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-input:focus-visible {
        outline: none;
        box-shadow: none;
        outline-offset: 0 !important;
        outline-width: 0 !important;
        border: 2px solid {{ block.settings.input_border_color }} !important;
      }

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-input::placeholder {
        color: {{ block.settings.input_placeholder_color }};
      }

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-button {
        min-width: fit-content;
        padding: 12px 24px;
        background-color: {{ block.settings.button_bg_color }};
        color: {{ block.settings.button_text_color }};
        border: none;
        border-radius: {{ block.settings.form_border_radius }}px;
        /* A <button> does not inherit font-family, so with none set here the
           browser used its own default (Arial) -- the one element on a
           generated page not in the page's typeface. */
        font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: none;
        {% if block.settings.enable_button_hover %}
        transition: all 0.3s ease;
        {% endif %}
      }

      {% if block.settings.enable_button_hover %}
      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-button:hover {
        background-color: {{ block.settings.button_hover_bg_color }};
        color: {{ block.settings.button_hover_text_color }};
      }
      {% endif %}

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-success {
        display: flex;
        flex-direction: column;
        gap: 5px;
        align-items: center;
      }

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-success-title {
        font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
        font-size: {{ block.settings.title_size }}px;
        color: {{ block.settings.title_color }};
        font-style: {{ block.settings.title_font.style }};
        font-weight: {{ block.settings.title_font.weight }};
        text-align: center;
      }

      .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-success-subtitle {
        font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
        font-size: {{ block.settings.description_size }}px;
        color: {{ block.settings.description_color }};
        font-style: {{ block.settings.description_font.style }};
        font-weight: {{ block.settings.description_font.weight }};
        line-height: 1.5;
        margin-bottom: 20px !important;
        text-align: center;
      }

      @media (max-width: 768px) {
        .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} {
          flex-direction: column;
          gap: 20px;
          align-items: flex-start;
          text-align: left;
          {% if block.settings.newsletter_br %}
          padding-bottom: 40px;
          {% endif %}
        }

        .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-text-content {
          text-align: left;
        }

        .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-form-container {
          min-width: unset;
        }

        .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-success {
          margin: 0 auto;
        }

        .st_footer-section-{{ section.id }} .contact-form {
            width: 100%;
        }

        .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-title {
          font-size: {{ block.settings.mobile_title_size }}px;
        }

        .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-description {
          font-size: {{ block.settings.mobile_description_size }}px;
        }

        .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-form {
          flex-direction: column;
        }

        .st_footer-section-{{ section.id }} .st_footer-newsletter-{{ block.id }} .st_footer-newsletter-input {
          min-width: unset;
        }
      }
    {% endif %}
  {% endfor %}

  /* Shop Detail Block Styles */
  {% for block in section.blocks %}
    {% if block.type == 'shop_detail' %}
      {{ block.settings.title_font | font_face }}
      {{ block.settings.description_font | font_face }}

      .st_footer-section-{{ section.id }} .st_footer-shop-detail-{{ block.id }}{
        max-width: 350px;
      }

      .st_footer-section-{{ section.id }} .st_footer-shop-detail-{{ block.id }} .st_footer-shop-logo {
        width: {{ block.settings.logo_width }}px;
        height: auto;
        margin-bottom: 15px;
      }

      .st_footer-section-{{ section.id }} .st_footer-shop-detail-{{ block.id }} .st_footer-shop-description *{
        font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
        font-size: {{ block.settings.description_size }}px;
        color: {{ block.settings.description_color }};
        font-style: {{ block.settings.description_font.style }};
        font-weight: {{ block.settings.description_font.weight }};
        line-height: 1.6;
      }

      {% if block.settings.show_support_badge %}
      .st_footer-section-{{ section.id }} .st_footer-shop-detail-{{ block.id }} .st_footer-shop-support-badge {
        background-color: {{ block.settings.support_badge_bg_color }};
        display: flex;
        align-items: center;
        gap: 5px;
        border-radius: 10rem;
        padding: 5px;
        margin-top: 15px;
        margin-bottom: 15px;
        width: 100%;
      }

      .st_footer-section-{{ section.id }} .st_footer-shop-detail-{{ block.id }} .st_footer-shop-support-badge-avatar {
        width: {{ block.settings.support_badge_avatar_size }}px;
        height: {{ block.settings.support_badge_avatar_size }}px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
      }

      .st_footer-section-{{ section.id }} .st_footer-shop-detail-{{ block.id }} .st_footer-shop-support-badge-text, .st_footer-section-{{ section.id }} .st_footer-shop-detail-{{ block.id }} .st_footer-shop-support-badge-text *{
        font-family: {{ block.settings.support_badge_text_font.family }}, {{ block.settings.support_badge_text_font.fallback_families }};
        font-size: {{ block.settings.support_badge_text_size }}px;
        color: {{ block.settings.support_badge_text_color }};
        font-style: {{ block.settings.support_badge_text_font.style }};
        font-weight: {{ block.settings.support_badge_text_font.weight }};
        margin: 0;
      }

      @media (max-width: 768px) {
              .st_footer-section-{{ section.id }} .st_footer-shop-detail-{{ block.id }} .st_footer-shop-support-badge-text, .st_footer-section-{{ section.id }} .st_footer-shop-detail-{{ block.id }} .st_footer-shop-support-badge-text *{
          font-size: {{ block.settings.mobile_support_badge_text_size }}px;
        }
      }
      {% endif %}

      @media (max-width: 768px) {
        .st_footer-section-{{ section.id }} .st_footer-shop-detail-{{ block.id }} h3 {
          font-size: {{ block.settings.mobile_title_size }}px;
        }

        .st_footer-section-{{ section.id }} .st_footer-shop-detail-{{ block.id }} .st_footer-shop-description *{
          font-size: {{ block.settings.mobile_description_size }}px;
        }
      }
    {% endif %}
  {% endfor %}

  /* Menu Links Block Styles */
  {% for block in section.blocks %}
    {% if block.type == 'menu_links' %}
      {{ block.settings.title_font | font_face }}
      {{ block.settings.link_font | font_face }}

      .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} h3 {
        font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
        font-size: {{ block.settings.title_size }}px;
        color: {{ block.settings.title_color }};
        font-style: {{ block.settings.title_font.style }};
        font-weight: {{ block.settings.title_font.weight }};
        margin-bottom: 15px;
      }

      .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} li {
        margin-bottom: 8px;
      }

      .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} a {
        font-family: {{ block.settings.link_font.family }}, {{ block.settings.link_font.fallback_families }};
        font-size: {{ block.settings.link_size }}px;
        color: {{ block.settings.link_color }};
        font-style: {{ block.settings.link_font.style }};
        font-weight: {{ block.settings.link_font.weight }};
        text-decoration: none;
        transition: color 0.3s ease;
      }

      .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} a:hover {
        color: {{ block.settings.link_hover_color }};
      }

      /* Hide mobile header on desktop */
      .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-header {
        display: none;
      }

      .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-content {
        max-height: none;
        overflow: visible;
      }

      @media (max-width: 768px) {
        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} {
          {% if block.settings.mobile_bottom_border %}
          border-bottom: 1px solid {{ block.settings.mobile_border_color }};
          padding-bottom: 10px;
          margin-bottom: 10px;
          {% endif %}
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-header {
          display: flex;
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-content {
          max-height: 0;
          overflow: hidden;
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          cursor: pointer;
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-icon {
          position: relative;
          width: 15px;
          height: 15px;
          cursor: pointer;
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-icon::before,
        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-icon::after {
          content: "";
          display: block;
          background-color: {{ block.settings.title_color }};
          position: absolute;
          top: 50%;
          left: 0;
          transition: 0.35s ease;
          width: 100%;
          height: 2px;
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-icon::before {
          transform: translateY(-50%);
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-icon::after {
          transform: translateY(-50%) rotate(90deg);
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-icon.collapsed::before {
          transform: translateY(-50%) rotate(-90deg);
          opacity: 0;
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-icon.collapsed::after {
          transform: translateY(-50%) rotate(0);
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-content {
          max-height: 0;
          overflow: hidden;
          transition: max-height 0.3s ease;
          padding-top: 10px;
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-content.open {
          max-height: 300px;
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} h3:not(.st_footer-mobile-header h3) {
          display: none;
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} .st_footer-mobile-header h3 {
          font-size: {{ block.settings.mobile_title_size }}px;
          margin-bottom: 0;
        }

        .st_footer-section-{{ section.id }} .st_footer-menu-links-{{ block.id }} a {
          font-size: {{ block.settings.mobile_link_size }}px;
        }
      }
    {% endif %}
  {% endfor %}

  /* Important Links Block Styles */
  {% for block in section.blocks %}
    {% if block.type == 'important_links' %}
      {{ block.settings.title_font | font_face }}
      {{ block.settings.link_font | font_face }}

      .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} h3 {
        font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
        font-size: {{ block.settings.title_size }}px;
        color: {{ block.settings.title_color }};
        font-style: {{ block.settings.title_font.style }};
        font-weight: {{ block.settings.title_font.weight }};
        margin-bottom: 15px;
      }

      .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} li {
        margin-bottom: 8px;
      }

      .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} a {
        font-family: {{ block.settings.link_font.family }}, {{ block.settings.link_font.fallback_families }};
        font-size: {{ block.settings.link_size }}px;
        color: {{ block.settings.link_color }};
        font-style: {{ block.settings.link_font.style }};
        font-weight: {{ block.settings.link_font.weight }};
        text-decoration: none;
        transition: color 0.3s ease;
      }

      .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} a:hover {
        color: {{ block.settings.link_hover_color }};
      }

      /* Hide mobile header on desktop */
      .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-header {
        display: none;
      }

      .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-content {
        max-height: none;
        overflow: visible;
      }

      @media (max-width: 768px) {
        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} {
          {% if block.settings.mobile_bottom_border %}
          border-bottom: 1px solid {{ block.settings.mobile_border_color }};
          padding-bottom: 10px;
          margin-bottom: 10px;
          {% endif %}
        }

        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-header {
          display: flex;
        }

        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-content {
          max-height: 0;
          overflow: hidden;
        }

        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          cursor: pointer;
        }

        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-icon {
          position: relative;
          width: 15px;
          height: 15px;
          cursor: pointer;
        }

        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-icon::before,
        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-icon::after {
          content: "";
          display: block;
          background-color: {{ block.settings.title_color }};
          position: absolute;
          top: 50%;
          left: 0;
          transition: 0.35s ease;
          width: 100%;
          height: 2px;
        }

        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-icon::before {
          transform: translateY(-50%);
        }

        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-icon::after {
          transform: translateY(-50%) rotate(90deg);
        }

        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-icon.collapsed::before {
          transform: translateY(-50%) rotate(-90deg);
          opacity: 0;
        }

        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-icon.collapsed::after {
          transform: translateY(-50%) rotate(0);
        }

        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-content {
          max-height: 0;
          overflow: hidden;
          transition: max-height 0.3s ease;
          padding-top: 10px;
        }

        .st_footer-section-{{ section.id }} .st_footer-important-links-{{ block.id }} .st_footer-mobile-content.open {
          max-height: 300px;
        }

