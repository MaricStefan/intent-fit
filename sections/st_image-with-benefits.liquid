<script
  src="https://app.sternify.com/verifier.js?v={{ 'now' | date: '%s' }}"
  data-section-id="{{ section.id }}"
  defer
></script>

<div class="st_not-found"></div>

{% style %}
  /* BFC gegen Margin-Collapsing mit Nachbar-Sections (Standard Regel 3) */
  #shopify-section-{{ section.id }} {
    display: flow-root;
    background-color: {{ section.settings.section_background_color }};
    padding-top: {{ section.settings.margin_top }}px;
    padding-bottom: {{ section.settings.margin_bottom }}px;
  }

  {%- assign main_font = section.settings.font_settings -%}
  {%- assign headline_font = section.settings.headline_font -%}
  {%- assign main_font_bolder = section.settings.font_settings | font_modify: 'weight', 'bolder' -%}
  {{ main_font | font_face }}
  {{ main_font_bolder | font_face }}
  {{ headline_font | font_face }}

  .st_imwb-wrapper * {
    font-family: "{{ main_font.family }}", {{ main_font.fallback_families }};
  }

  .st_imwb-wrapper{
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .st_imwb-wrapper{
      {% if section.settings.desktop_card_layout %}
      padding-inline: 45px;
      {% elsif section.settings.full_width %}
      {% else %}
      padding-inline: 0;
      {% endif %}
    }
  }

  /* ── Counter st_reset.css to allow richtext styling ── */
  .st_imwb-wrapper :is(strong, b),
  .st_imwb-wrapper :is(strong, b) * {
    font-weight: bold !important;
    font-family: inherit;
    color: inherit;
    font-style: inherit;
  }

  .st_imwb-wrapper :is(em, i),
  .st_imwb-wrapper :is(em, i) * {
    font-style: italic !important;
    font-family: inherit;
    color: inherit;
    font-weight: inherit;
  }

  .st_imwb-wrapper span {
    font-size: inherit;
    font-family: inherit;
    color: inherit;
    font-style: inherit;
    font-weight: inherit;
  }
  /* --- */

  .st_stl-wrapper div:empty {
    display: unset;
  }


  /*-_- -_- -_- Desktop -_- -_- -_- */
  .st_ImageInfo {
  	--Horizontal-Gap: 40px;
  	position: relative;
  	display: flex;
  	flex-direction: row;
  	flex-wrap: wrap;
  	justify-content: space-between;
  	align-items: center;
  	gap: 40px var(--Horizontal-Gap);
  	padding-block: 48px;
    {% comment %} max_block_width war frueher in rem (110-180); gespeicherte
    Altwerte werden auf px umgerechnet, neue Werte sind direkt px. {% endcomment %}
    {% if section.settings.full_width and section.settings.desktop_card_layout == false %}
    max-width: 100%;
    {% elsif section.settings.max_block_width <= 200 %}
    max-width: {{ section.settings.max_block_width | times: 10 }}px;
    {% else %}
    max-width: {{ section.settings.max_block_width }}px;
    {% endif %}
    margin: 0 auto;
    padding: 20px;
    {% if section.settings.desktop_card_layout %}
    background-color: {{ section.settings.section_bg_color }};
    {% endif %}
  }

  @media (min-width: 768px) {
    .st_ImageInfo {
      {% if section.settings.desktop_card_layout %}
      border-radius: 12px;
      padding: 40px 60px;
      {% endif %}
    }
  }

  .st_ImageInfo-benefits-wrapper {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 30px;
  }

  .st_ImageInfo-TopTitle .highlight {
    {% if section.settings.header_title_highlight_mode == 'gradient' %}
      background: {{ section.settings.header_title_highlight_gradient }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    {% else %}
      color: {{ section.settings.header_title_highlight_color }} !important;
    {% endif %}
    display: inline;
  }

  .st_ImageInfo-TopTitle {
  	position: relative;
  	width: 100%;
  	color: {{ section.settings.headline_text_color }};
  	font-family: {{ headline_font.family }}, {{ headline_font.fallback_families }};
  	font-weight: {{ headline_font.weight }};
  	font-style: normal;
  	font-size: {{ section.settings.headline_text_size }}px;
  	line-height: normal;
  	text-align: center;
  }
  .st_ImageInfo-Side {
    grid-column: span 2;
  	gap: 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .st_ImageInfo-Left {
  	position: relative;
  }
  .st_ImageInfo-Box {
  	position: relative;
  	display: flex;
  	flex-direction: column;
  	justify-content: center;
  	align-items: center;
  	gap: 10px;
  }
  .st_ImageInfo-Box-Icon {
  	position: relative;
  	height: {{ section.settings.icon_size_desktop }}px;
  	object-fit: contain;
  }
  .st_ImageInfo-Box-Title {
  	position: relative;
    color: {{ section.settings.benefit_title_color }};
  	font-family: {{ main_font_bolder.family }}, {{ main_font_bolder.fallback_families }};
  	font-weight: {{ main_font_bolder.weight }};
  	font-size: 25px;
  	line-height: normal;
    text-align: center;
    line-break: loose;
  }
  .st_ImageInfo-Box-Text, .st_ImageInfo-Box-Text * {
  	position: relative;
    color: {{ section.settings.benefit_text_color }};
  	font-family: {{ main_font.family }}, {{ main_font.fallback_families }};
  	font-weight: {{ main_font.weight }};
  	font-style: normal;
  	font-size: 16px;
  	line-height: normal !important;
  	text-align: center;
  }
  .st_ImageInfo-Center {
  	position: relative;
  	grid-column: span 4;
    display: flex;
  }
  .st_ImageInfo-Image {
  	position: relative;
  	width: 100%;
    object-fit: contain;
    height: 100%;
  }
  .st_ImageInfo-Right {
  	position: relative;
  }

  /*-_- -_- -_- labtop -_- -_- -_-*/
  @media (max-width: 1080px) {
  	.st_ImageInfo {
  		--Horizontal-Gap: 80px;
  		position: relative;
  		display: flex;
  		flex-direction: row;
  		flex-wrap: wrap;
  		justify-content: space-between;
  		align-items: center;
  		gap: 40px var(--Horizontal-Gap);
  		padding-block: 63px;
  	}

    .st_ImageInfo-benefits-wrapper {
      grid-template-columns: 1fr 1fr;
      gap: 0px;
    }

    .st_ImageInfo-Center{
      grid-row: 1;
      position: relative;
  		width: 100%;
      padding-bottom: 20px;
    }

  	.st_ImageInfo-TopTitle {
  		position: relative;
  		width: 100%;
  		font-style: normal;
  		font-size: {{ section.settings.headline_text_size | minus: 10 }}px;
  		line-height: normal;
  		text-align: center;
  	}

  	.st_ImageInfo-Side {
  		position: relative;
  		display: flex;
  		flex-direction: column;
  		align-items: center;
      justify-content: space-between;
  		gap: 30px;
      grid-column: span 1;
  	}
  	.st_ImageInfo-Left {
  		position: relative;
      padding-right: 20px;
  	}
  	.st_ImageInfo-Box {
  		position: relative;
  		display: flex;
  		flex-direction: column;
  		justify-content: center;
  		align-items: center;
  		gap: 17px;
  	}
  	.st_ImageInfo-Box-Icon {
  		position: relative;
  		height: {{ section.settings.icon_size_desktop }}px;
  		object-fit: contain;
      margin-bottom: -10px;
  	}
  	.st_ImageInfo-Box-Text {
  		position: relative;
  		text-align: center;
  	}

  	.st_ImageInfo-Image {
  		position: relative;
  		width: 100%;
  	}
  	.st_ImageInfo-Right {
  		position: relative;
  	}
  }

  /*-_- -_- -_- Tablet -_- -_- -_-*/
  @media (max-width: 728px) {
  	.st_ImageInfo {
  		--Horizontal-Gap: 35px;
  		position: relative;
  		display: flex;
  		flex-direction: row;
  		flex-wrap: wrap;
  		justify-content: space-between;
  		align-items: center;
  		gap: 75px var(--Horizontal-Gap);
  		padding-block: 35px;
  	}

  	.st_ImageInfo-TopTitle {
  		position: relative;
  		width: 100%;
  		font-size: {{ section.settings.headline_text_size | minus: 10 }}px;
  		line-height: normal;
  		text-align: center;
  	}
  	.st_ImageInfo-Left {
  		position: relative;
  	}
  	.st_ImageInfo-Box {
  		position: relative;
  		display: flex;
  		flex-direction: column;
  		justify-content: center;
  		align-items: center;
  		gap: 17px;
  	}
  	.st_ImageInfo-Box-Icon {
  		position: relative;
  		height: {{ section.settings.icon_size_mobile }}px;
  		object-fit: contain;
  	}
  	.st_ImageInfo-Box-Text {
  		text-align: center;
  	}
  	.st_ImageInfo-Center {
  		position: relative;
  		width: 100%;
  	}
  	.st_ImageInfo-Image {
  		position: relative;
  		width: 100%;
  	}
  	.st_ImageInfo-Right {
  		position: relative;
      padding-left: 10px
  	}
  }

  /*-_- -_- -_- Mobile -_- -_- -_-*/
  @media (max-width: 480px) {

  	.st_ImageInfo {
  		--Horizontal-Gap: 30px;
  		position: relative;
  		display: flex;
  		flex-direction: row;
  		flex-wrap: wrap;
  		justify-content: space-between;
  		align-items: center;
  		gap: 49px var(--Horizontal-Gap);
  		padding-block: 28px;
  	}
  	.st_ImageInfo-TopTitle {
  		position: relative;
  		width: 100%;
  		font-size: {{ section.settings.headline_text_size_mobile }}px;
  		line-height: normal;
  		text-align: center;
  	}
  	.st_ImageInfo-Left {
  		position: relative;
      padding-right: 10px;
  	}
  	.st_ImageInfo-Box {
  		position: relative;
  		display: flex;
  		flex-direction: column;
  		align-content: flex-start;
  		justify-content: center;
  		align-items: flex-start;
  	}
  	.st_ImageInfo-Box-Icon {
  		position: relative;
  		height: {{ section.settings.icon_size_mobile }}px;
  		object-fit: contain;
  	}
  	.st_ImageInfo-Box-Title {
  		font-size: 18px;
  		text-align: left;
  	}
  	.st_ImageInfo-Box-Text, .st_ImageInfo-Box-Text * {
  		position: relative;
  		font-size: 14px;
  		text-align: left;
  	}
  	.st_ImageInfo-Center {
  		position: relative;
  		width: 100%;
  	}
  	.st_ImageInfo-Image {
  		position: relative;
  		width: 100%;
  	}
  	.st_ImageInfo-Right {
  		position: relative;
      grid-column: span 2;
  	}
  }
{% endstyle %}

{% assign benefit_blocks_count = section.blocks.size %}

<div class="st_wrapper st_imwb-wrapper st_check-section--{{ section.id }}">
  <div class="st_ImageInfo">
    <div class="st_ImageInfo-TopTitle">{{ section.settings.headline_text | replace: '[', '<span class="highlight">' | replace: ']', '</span>' }}</div>
    {% if benefit_blocks_count > 0 %}
      <div class="st_ImageInfo-benefits-wrapper">
        <div class="st_ImageInfo-Side st_ImageInfo-Left">
          {% for benefit_block in section.blocks %}
            {% if forloop.index0 == 0 or forloop.index0 == 2 or forloop.index0 == 4 %}
              <div class="st_ImageInfo-Box">
                {% if benefit_block %}
                  {% if benefit_block.settings.benefit_icon %}
                    <img
                      class="st_ImageInfo-Box-Icon"
                      src="{{ benefit_block.settings.benefit_icon | img_url: '100x100' }}"
                      width="{{ section.settings.icon_size_desktop }}"
                      height="{{ section.settings.icon_size_desktop }}"
                      alt="{{ benefit_block.settings.benefit_title }} icon"
                    >
                  {% elsif benefit_block.settings.benefit_icon_demo_url != blank %}
                    <img
                      class="st_ImageInfo-Box-Icon"
                      src="{{ benefit_block.settings.benefit_icon_demo_url }}"
                      alt="{{ benefit_block.settings.benefit_title }} icon"
                    >
                  {% else %}
                    <img
                      class="st_ImageInfo-Box-Icon"
                      src="https://cdn.shopify.com/s/files/1/0799/5880/2740/files/wind.svg?v=1718547931"
                      width="{{ section.settings.icon_size_desktop }}"
                      height="{{ section.settings.icon_size_desktop }}"
                      alt="Benefit icon"
                    >
                  {% endif %}
                  <div class="st_ImageInfo-Box-Title">{{ benefit_block.settings.benefit_title }}</div>
                  <div class="st_ImageInfo-Box-Text">
                    {{ benefit_block.settings.benefit_text }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="st_ImageInfo-Center">
          {% if section.settings.main_image %}
            {{ section.settings.main_image | image_url: width: 800 | image_tag: class: 'st_ImageInfo-Image', width: 800, height: 800, alt: section.settings.headline_text }}
          {% elsif section.settings.main_image_demo_url != blank %}
            <img
              class="st_ImageInfo-Image"
              src="{{ section.settings.main_image_demo_url }}"
              alt="{{ section.settings.headline_text }}"
            >
          {% else %}
            <img
              class="st_ImageInfo-Image"
              src="https://cdn.shopify.com/s/files/1/0799/5880/2740/files/example_product_cropped.png?v=1718548170"
              width="800"
              height="800"
              alt="Product image"
            >
          {% endif %}
        </div>
        <div class="st_ImageInfo-Side st_ImageInfo-Right">
          {% for benefit_block in section.blocks %}
            {% if forloop.index0 == 1 or forloop.index0 == 3 or forloop.index0 == 5 %}
              <div class="st_ImageInfo-Box">
                {% if benefit_block %}
                  {% if benefit_block.settings.benefit_icon %}
                    <img
                      class="st_ImageInfo-Box-Icon"
                      src="{{ benefit_block.settings.benefit_icon | img_url: '100x100' }}"
                      width="{{ section.settings.icon_size_desktop }}"
                      height="{{ section.settings.icon_size_desktop }}"
                      alt="{{ benefit_block.settings.benefit_title }} icon"
                    >
                  {% elsif benefit_block.settings.benefit_icon_demo_url != blank %}
                    <img
                      class="st_ImageInfo-Box-Icon"
                      src="{{ benefit_block.settings.benefit_icon_demo_url }}"
                      alt="{{ benefit_block.settings.benefit_title }} icon"
                    >
                  {% else %}
                    <img
                      class="st_ImageInfo-Box-Icon"
                      src="https://cdn.shopify.com/s/files/1/0799/5880/2740/files/wind.svg?v=1718547931"
                      width="{{ section.settings.icon_size_desktop }}"
                      height="{{ section.settings.icon_size_desktop }}"
                      alt="Benefit icon"
                    >
                  {% endif %}
                  <div class="st_ImageInfo-Box-Title">{{ benefit_block.settings.benefit_title }}</div>
                  <div class="st_ImageInfo-Box-Text">
                    {{ benefit_block.settings.benefit_text }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="st_ImageInfo-benefits-wrapper">
        <div class="st_ImageInfo-Side st_ImageInfo-Left">
          <div class="st_ImageInfo-Box">
            <img
              class="st_ImageInfo-Box-Icon"
              src="https://cdn.shopify.com/s/files/1/0799/5880/2740/files/wind.svg?v=1718547931"
              width="{{ section.settings.icon_size_desktop }}"
              height="{{ section.settings.icon_size_desktop }}"
              alt="Rich Aroma icon"
            >
            <div class="st_ImageInfo-Box-Title">Rich Aroma</div>
            <div class="st_ImageInfo-Box-Text">
              Enjoy the rich aroma and deep flavor of our freshly roasted coffee beans. Perfect to start your day right.
            </div>
          </div>
          <div class="st_ImageInfo-Box">
            <img
              class="st_ImageInfo-Box-Icon"
              src="https://cdn.shopify.com/s/files/1/0799/5880/2740/files/tree.svg?v=1718547931"
              width="{{ section.settings.icon_size_desktop }}"
              height="{{ section.settings.icon_size_desktop }}"
              alt="Sustainably Sourced icon"
            >
            <div class="st_ImageInfo-Box-Title">Sustainably Sourced</div>
            <div class="st_ImageInfo-Box-Text">
              Our beans are sourced sustainably from the best coffee plantations in the world, ensuring quality and ethical practices.
            </div>
          </div>
          <div class="st_ImageInfo-Box">
            <img
              class="st_ImageInfo-Box-Icon"
              src="https://cdn.shopify.com/s/files/1/0799/5880/2740/files/coffee-bean.svg?v=1718547931"
              width="{{ section.settings.icon_size_desktop }}"
              height="{{ section.settings.icon_size_desktop }}"
              alt="Expertly Roasted icon"
            >
            <div class="st_ImageInfo-Box-Title">Expertly Roasted</div>
            <div class="st_ImageInfo-Box-Text">
              Each batch is expertly roasted to highlight the unique aromas and characteristics of each bean.
            </div>
          </div>
        </div>
        <div class="st_ImageInfo-Center">
          {% if section.settings.main_image %}
            {{ section.settings.main_image | image_url: width: 800 | image_tag: class: 'st_ImageInfo-Image', width: 800, height: 800, alt: section.settings.headline_text }}
          {% elsif section.settings.main_image_demo_url != blank %}
            <img
              class="st_ImageInfo-Image"
              src="{{ section.settings.main_image_demo_url }}"
              alt="{{ section.settings.headline_text }}"
            >
          {% else %}
            <img
              class="st_ImageInfo-Image"
              src="https://cdn.shopify.com/s/files/1/0799/5880/2740/files/example_product_cropped.png?v=1718548170"
              width="800"
              height="800"
              alt="Product image"
            >
          {% endif %}
        </div>
        <div class="st_ImageInfo-Side st_ImageInfo-Right">
          <div class="st_ImageInfo-Box">
            <img
              class="st_ImageInfo-Box-Icon"
              src="https://cdn.shopify.com/s/files/1/0799/5880/2740/files/flower-lotus.svg?v=1718547931"
              width="{{ section.settings.icon_size_desktop }}"
              height="{{ section.settings.icon_size_desktop }}"
              alt="Freshness Guaranteed icon"
            >
            <div class="st_ImageInfo-Box-Title">Freshness Guaranteed</div>
            <div class="st_ImageInfo-Box-Text">
              We guarantee the freshness of our coffee and offer a premium experience in every cup.
            </div>
          </div>
          <div class="st_ImageInfo-Box">
            <img
              class="st_ImageInfo-Box-Icon"
              src="https://cdn.shopify.com/s/files/1/0799/5880/2740/files/coffee.svg?v=1718547931"
              width="{{ section.settings.icon_size_desktop }}"
              height="{{ section.settings.icon_size_desktop }}"
              alt="Versatile Brewing icon"
            >
            <div class="st_ImageInfo-Box-Title">Versatile Brewing</div>
            <div class="st_ImageInfo-Box-Text">
              Whether you prefer espresso, filter coffee, or French press, our coffee beans are perfect for all brewing methods.
            </div>
          </div>
          <div class="st_ImageInfo-Box">
            <img
              class="st_ImageInfo-Box-Icon"
              src="https://cdn.shopify.com/s/files/1/0799/5880/2740/files/sparkle.svg?v=1718547931"
              width="{{ section.settings.icon_size_desktop }}"
              height="{{ section.settings.icon_size_desktop }}"
              alt="Delicious Taste icon"
            >
            <div class="st_ImageInfo-Box-Title">Delicious Taste</div>
            <div class="st_ImageInfo-Box-Text">
              Experience a delicious taste with every sip, perfected for coffee lovers around the world.
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "💫: Image with Benefits",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "⚠️ Important ⚠️",
      "info": "Please ensure that Sternify [App Extensions](https://www.sternify.com/app-extentions) are activated."
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top Margin",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom Margin",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section Background Color",
      "default": "rgba(0,0,0,0)",
      "info": "Fills the full section including the top and bottom margins"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width",
      "default": false,
      "visible_if": "{{ section.settings.desktop_card_layout == false }}"
    },
    {
      "type": "range",
      "id": "max_block_width",
      "min": 1200,
      "max": 1600,
      "step": 50,
      "default": 1400,
      "unit": "px",
      "label": "Section Max Width",
      "visible_if": "{{ section.settings.desktop_card_layout or section.settings.full_width == false }}"
    },
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "checkbox",
      "id": "desktop_card_layout",
      "label": "Desktop Card Layout",
      "default": true
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Card Background Color",
      "default": "rgba(0,0,0,0)",
      "visible_if": "{{ section.settings.desktop_card_layout }}"
    },
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image",
      "info": "Choose the image to be displayed in the center"
    },
    {
      "type": "text",
      "id": "main_image_demo_url",
      "label": "Demo Image URL",
      "default": "https://cdn.shopify.com/s/files/1/0799/5880/2740/files/example_product_cropped.png?v=1718548170",
      "visible_if": "{{ section.settings.main_image_demo_url == 'st-internal' }}"
    },
    {
      "type": "inline_richtext",
      "id": "headline_text",
      "label": "Headline",
      "info": "You can highlight text by wrapping it in [brackets]",
      "default": "Why Sternify?"
    },
    {
      "type": "select",
      "id": "header_title_highlight_mode",
      "label": "Title Highlight Mode",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "header_title_highlight_color",
      "label": "Title Highlight Color",
