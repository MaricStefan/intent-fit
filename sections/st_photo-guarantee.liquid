      "default": "4"
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Desktop Image Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.num_images == '1' or section.settings.num_images == '3' }}"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image Border Radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "enable_image_frame",
      "label": "Enable Image Frame",
      "default": true
    },
    {
      "type": "color",
      "id": "image_frame_color",
