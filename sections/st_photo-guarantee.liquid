        { "value": "solid", "label": "Solid" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "button_bg_color_solid",
      "label": "Button Background Color",
      "default": "#1a1a1a",
      "visible_if": "{{ section.settings.button_bg_color_mode == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "button_bg_color_gradient",
      "label": "Button Background Color",
      "default": "linear-gradient(0deg, #1a1a1a, #1a1a1a 100%)",
      "visible_if": "{{ section.settings.button_bg_color_mode == 'gradient' }}"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "TRY IT OUT",
      "visible_if": "{{ section.settings.button_enable }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.button_enable }}"
    },
    {
      "type": "font_picker",
      "id": "button_text_font",
      "label": "Button Text Font",
      "default": "poppins_n6",
      "visible_if": "{{ section.settings.button_enable }}"
    },
    {
      "type": "range",
      "id": "button_text_fontsize",
      "label": "Button Text Font Size",
      "min": 13,
      "max": 23,
      "step": 1,
      "default": 16,
      "unit": "px",
      "visible_if": "{{ section.settings.button_enable }}"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button Border Radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 6,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Benefits"
    },
    {
      "type": "color",
      "id": "benefit_text_color",
      "label": "Benefit Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "font_picker",
      "id": "benefit_text_font",
      "label": "Benefit Text Font",
      "default": "poppins_n4"
    },
    {
      "type": "range",
      "id": "benefit_text_fontsize",
      "label": "Benefit Text Font Size",
      "min": 12,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "benefit_icon_size_desktop",
      "label": "Benefit Icon Size (Desktop)",
      "min": 20,
      "max": 48,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "benefit_icon_size_mobile",
      "label": "Benefit Icon Size (Mobile)",
      "min": 18,
      "max": 34,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Images"
