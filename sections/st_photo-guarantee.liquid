    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "benefit_icon",
          "label": "Benefit Icon"
        },
        {
          "type": "text",
          "id": "benefit_icon_demo_url",
          "label": "Demo Benefit Icon URL",
          "visible_if": "{{ block.settings.benefit_icon_demo_url == 'st-internal' }}"
        },
        {
          "type": "text",
          "id": "benefit_title",
          "label": "Benefit Title",
          "default": "Benefit Title"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_demo_url",
          "label": "Demo Image URL",
          "visible_if": "{{ block.settings.image_demo_url == 'st-internal' }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "💫: Photo Guarantee",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
