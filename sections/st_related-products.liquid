<script
  src="https://app.sternify.com/verifier.js?v={{ 'now' | date: '%s' }}"
  data-section-id="{{ section.id }}"
  defer
></script>

<div id="st_not-found--{{ section.id }}" class="st_not-found" style="display: none;"></div>

<!-- Swiper JS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/8.4.7/swiper-bundle.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/8.4.7/swiper-bundle.min.js"></script>

<style>
  /* BFC gegen Margin-Collapsing mit Nachbar-Sections (Standard Regel 3) */
  #shopify-section-{{ section.id }} {
    display: flow-root;
    background-color: {{ section.settings.section_background_color }};
    padding-top: {{ section.settings.margin_top }}px;
    padding-bottom: {{ section.settings.margin_bottom }}px;
  }

  {%- assign header_title_font = section.settings.header_font -%}
  {%- assign header_subtitle_font = section.settings.section_subtitle_font -%}
  {%- assign product_title_font = section.settings.product_title_font -%}
  {%- assign product_price_font = section.settings.product_price_font -%}

  {{ header_title_font | font_face }}
  {{ header_subtitle_font | font_face }}
  {{ product_title_font | font_face }}
  {{ product_price_font | font_face }}

  .st_related-products--{{ section.id }} {
    overflow: hidden;
    {% if section.settings.desktop_card_layout %}
      padding-inline: 45px;
      margin: 0 auto;
    {% elsif section.settings.full_width %}
      padding-inline: 0;
    {% else %}
      padding-inline: 0;
      margin: 0 auto;
    {% endif %}
  }

  .st_related-products--{{ section.id }} .st_related-products-section {
    {% if section.settings.desktop_card_layout %}
    background-color: {{ section.settings.section_bg_color }};
    {% endif %}
    padding-block: 50px;
    {% if section.settings.desktop_card_layout %}
    padding-inline: 50px;
    {% elsif section.settings.full_width %}
    padding-inline: 50px;
    {% else %}
    padding-inline: 15px;
    {% endif %}
    {% if section.settings.desktop_card_layout %}
      max-width: {{ section.settings.max_width }}px;
      margin-inline: auto;
      border-radius: 12px;
      overflow: hidden;
    {% elsif section.settings.full_width %}
      border-radius: none;
      max-width: 100%;
    {% else %}
      max-width: {{ section.settings.max_width }}px;
      margin-inline: auto;
      border-radius: 0;
      overflow: hidden;
    {% endif %}
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .st_related-products--{{ section.id }} .st_related-products-container {
    /* max-width: {{ section.settings.max_width }}px; */
    width: 100%;
  }

  .st_related-products--{{ section.id }} .st_related-products-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .st_related-products--{{ section.id }} .st_related-products-highlight {
    {% if section.settings.header_title_highlight_mode == 'gradient' %}
      background: {{ section.settings.header_title_highlight_gradient }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    {% else %}
      color: {{ section.settings.header_title_highlight_color }} !important;
    {% endif %}
  }

  /* ── Counter st_reset.css to allow richtext styling ── */
  .st_related-products--{{ section.id }} :is(strong, b),
  .st_related-products--{{ section.id }} :is(strong, b) * {
    font-weight: bold !important;
    font-family: inherit;
    color: inherit;
    font-style: inherit;
  }

  .st_related-products--{{ section.id }} :is(em, i),
  .st_related-products--{{ section.id }} :is(em, i) * {
    font-style: italic !important;
    font-family: inherit;
    color: inherit;
    font-weight: inherit;
  }

  .st_related-products--{{ section.id }} span {
    font-size: inherit;
    font-family: inherit;
    color: inherit;
    font-style: inherit;
    font-weight: inherit;
  }
  /* --- */

  .st_related-products--{{ section.id }} .st_related-products-title,
  .st_related-products--{{ section.id }} .st_related-products-highlight {
    font-family: {{ header_title_font.family }}, {{ header_title_font.fallback_families }};
    font-weight: {{ header_title_font.weight }};
    font-style: {{ header_title_font.style }};
    display: inline;
    font-size: {{ section.settings.header_fontsize_desktop }}px;
    color: {{ section.settings.header_color }};
    margin: 0;
    line-height: 1.2;
  }

  .st_related-products--{{ section.id }} .st_related-products-subtitle {
    font-family: {{ header_subtitle_font.family }}, {{ header_subtitle_font.fallback_families }};
    font-weight: {{ header_subtitle_font.weight }};
    font-style: {{ header_subtitle_font.style }};
    font-size: {{ section.settings.section_subtitle_fontsize_desktop }}px;
    text-align: center;
    color: {{ section.settings.section_subtitle_color }};
    /* Section standard: 10px under the section title. */
    margin: 10px 0 0;
  }


  /* Product Card */
  .st_related-products--{{ section.id }} .st_related-product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    {% if section.settings.card_style == 'blank' %}
      gap: 15px;
    {% elsif section.settings.card_style == 'full_card' %}
      gap: 15px;
      padding: 20px;
      background: {{ section.settings.card_bg_color }};
      border: 1px solid {{ section.settings.card_border_color }};
      border-radius: {{ section.settings.image_border_radius }}px;
    {% elsif section.settings.card_style == 'text_card' %}
      gap: 0px;
      background: {{ section.settings.card_bg_color }};
      border: 1px solid {{ section.settings.card_border_color }};
      border-radius: {{ section.settings.image_border_radius }}px;
    {% endif %}
    text-decoration: none;
    {% if section.settings.enable_card_hover_lift %}
      transition: transform 0.3s ease;
    {% endif %}
  }

  {% if section.settings.enable_card_hover_lift %}
    .st_related-products--{{ section.id }} .st_related-product-card:hover {
      transform: translateY(-5px);
    }
  {% endif %}

  /* Product Image Container */
  .st_related-products--{{ section.id }} .st_related-product-image-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 100%; /* 1:1 Aspect Ratio */
    overflow: hidden;
    {% if section.settings.card_style == 'text_card' %}
      border-top-right-radius: {{ section.settings.image_border_radius }}px;
      border-top-left-radius: {{ section.settings.image_border_radius }}px;
    {% else %}
      border-radius: {{ section.settings.image_border_radius }}px;
    {% endif %}
  }

  .st_related-products--{{ section.id }} .st_related-product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .st_related-products--{{ section.id }} .st_related-product-image.hover-image {
    opacity: 0;
  }

  /* Only apply hover effect if product has a second image */
  .st_related-products--{{ section.id }} .st_related-product-card.has-hover-image:hover .st_related-product-image.hover-image {
    opacity: 1;
  }

  .st_related-products--{{ section.id }} .st_related-product-card.has-hover-image:hover .st_related-product-image.main-image {
    opacity: 0;
  }

  /* Product Info */
  .st_related-products--{{ section.id }} .st_related-product-info {
    text-align: {{ section.settings.product_info_alignment }};
    display: flex;
    flex-direction: column;
    {% if section.settings.product_info_alignment == 'left' %}
      align-items: flex-start;
    {% elsif section.settings.product_info_alignment == 'center' %}
      align-items: center;
    {% elsif section.settings.product_info_alignment == 'right' %}
      align-items: flex-end;
    {% endif %}
    gap: 8px;
    {% if section.settings.card_style == 'text_card' %}
      padding: 20px;
    {% endif %}
  }

  .st_related-products--{{ section.id }} .st_related-product-title {
    font-family: {{ product_title_font.family }}, {{ product_title_font.fallback_families }};
    font-weight: {{ product_title_font.weight }};
    font-style: {{ product_title_font.style }};
    font-size: {{ section.settings.product_title_fontsize }}px;
    color: {{ section.settings.product_title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .st_related-products--{{ section.id }} .st_related-product-price {
    font-family: {{ product_price_font.family }}, {{ product_price_font.fallback_families }};
    font-weight: {{ product_price_font.weight }};
    font-style: {{ product_price_font.style }};
    font-size: {{ section.settings.product_price_fontsize }}px;
    color: {{ section.settings.product_price_color }} !important;
  }

  .st_related-products--{{ section.id }} .st_related-product-price .compare-at-price {
    text-decoration: line-through;
    opacity: 0.6;
    margin-left: 8px;
    color: {{ section.settings.product_price_color }} !important;
  }

  /* Sale Badge */
  .st_related-products--{{ section.id }} .st_sale-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    margin-left: 8px;
    border-radius: {{ section.settings.badge_border_radius }}px;
    {% if section.settings.enable_badge_gradient %}
      background: {{ section.settings.badge_gradient }};
    {% else %}
      background-color: {{ section.settings.badge_bg_color }};
    {% endif %}
    font-size: {{ section.settings.badge_text_size }}px;
    color: {{ section.settings.badge_text_color }};
    font-family: {{ product_title_font.family }}, {{ product_title_font.fallback_families }};
    font-weight: {{ product_title_font.weight }};
    font-style: {{ product_title_font.style }};
  }

  .st_related-products--{{ section.id }} .st_sale-badge *{
    color: {{ section.settings.badge_text_color }};
    font-family: {{ product_title_font.family }}, {{ product_title_font.fallback_families }};
    font-weight: {{ product_title_font.weight }};
    font-style: {{ product_title_font.style }};
  }

  .st_related-products--{{ section.id }} .st_sale-badge svg {
    width: calc({{ section.settings.badge_text_size }}px * 1.5);
    height: calc({{ section.settings.badge_text_size }}px * 1.5);
    fill: currentColor;
  }

  /* Swiper Container */
  .st_related-products--{{ section.id }} .st_related-products-swiper {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  /* Swiper Styles */
  .st_related-products--{{ section.id }} .swiper {
    width: 100%;
    overflow: visible !important;
    position: relative;
  }

  .st_related-products--{{ section.id }} .swiper-wrapper {
    overflow: visible;
    max-width: fit-content;
    margin: 0 auto;
    align-items: stretch;
  }

  .st_related-products--{{ section.id }} .swiper-slide {
    height: auto;
    width: 280px !important;
    display: flex;
  }

  .st_related-products--{{ section.id }} .swiper-slide > * {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Navigation Buttons */
  .st_related-products--{{ section.id }} div:empty {
    display: flex !important;
  }

  .st_related-products--{{ section.id }} .swiper-button-next,
  .st_related-products--{{ section.id }} .swiper-button-prev {
    display: flex !important;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: {{ section.settings.nav_arrow_color }};
    {% if section.settings.enable_nav_arrow_background %}
      background: {{ section.settings.nav_arrow_bg_color }};
      backdrop-filter: blur(10px);
    {% else %}
      background: none;
      backdrop-filter: none;
    {% endif %}
    width: 60px;
    height: 60px;
    border: none;
    border-radius: 50%;
    transition: all 0.4s ease;
    z-index: 20;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .st_related-products--{{ section.id }} .swiper-button-next {
    right: 0px;
  }

  .st_related-products--{{ section.id }} .swiper-button-prev {
    left: 0px;
  }

  .st_related-products--{{ section.id }} .swiper-button-next:after,
  .st_related-products--{{ section.id }} .swiper-button-prev:after {
    font-size: 20px;
    font-weight: 700;
  }

  .st_related-products--{{ section.id }} .swiper-button-next:hover,
  .st_related-products--{{ section.id }} .swiper-button-prev:hover {
    transform: translateY(-50%) scale(1.1);
  }

  .st_related-products--{{ section.id }} .swiper-button-disabled {
    opacity: 0 !important;
    pointer-events: none;
    visibility: hidden;
  }

  /* Mobile Styles */
  @media (max-width: 1000px) {
    .st_related-products--{{ section.id }} {
      padding-inline: 0;
    }

    /* Disable hover effects on mobile */
    .st_related-products--{{ section.id }} .st_related-product-card {
      transition: none !important;
    }

    .st_related-products--{{ section.id }} .st_related-product-card:hover {
      transform: none !important;
    }

    .st_related-products--{{ section.id }} .st_related-product-card.has-hover-image:hover .st_related-product-image.hover-image {
      opacity: 0 !important;
    }

    .st_related-products--{{ section.id }} .st_related-product-card.has-hover-image:hover .st_related-product-image.main-image {
      opacity: 1 !important;
    }

      .st_related-products--{{ section.id }} .st_related-products-section {
        border-radius: 0;
        max-width: 100%;
      }

    /* Mobile Navigation Buttons */
    .st_related-products--{{ section.id }} .swiper-button-next,
    .st_related-products--{{ section.id }} .swiper-button-prev {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      {% if section.settings.enable_nav_arrow_background %}
        background: {{ section.settings.nav_arrow_bg_color }};
        backdrop-filter: blur(10px);
      {% else %}
        background: none;
        backdrop-filter: none;
      {% endif %}
      width: 40px;
      height: 40px;
      border-radius: 50%;
      transition: all 0.4s ease;
      z-index: 10;
      display: flex !important;
      align-items: center;
      justify-content: center;
    }

    .st_related-products--{{ section.id }} .swiper-button-next {
      right: 10px;
    }

    .st_related-products--{{ section.id }} .swiper-button-prev {
      left: 10px;
    }

    .st_related-products--{{ section.id }} .swiper-button-next:after,
    .st_related-products--{{ section.id }} .swiper-button-prev:after {
      font-size: 16px;
      font-weight: 700;
    }

    .st_related-products--{{ section.id }} .swiper-button-next:hover,
    .st_related-products--{{ section.id }} .swiper-button-prev:hover {
      {% if section.settings.enable_nav_arrow_background %}
        transform: translateY(-50%) scale(1.1);
      {% else %}
        transform: translateY(-50%) scale(1.2);
      {% endif %}
    }
  }

  @media (max-width: 768px) {
    .st_related-products--{{ section.id }} .st_related-products-title,
    .st_related-products--{{ section.id }} .st_related-products-highlight {
      font-size: {{ section.settings.header_fontsize_mobile }}px !important;
    }

    .st_related-products--{{ section.id }} .swiper-slide {
      width: {{ section.settings.mobile_card_size }}px !important;
    } 

    .st_related-products--{{ section.id }} .st_related-products-subtitle {
      font-size: {{ section.settings.section_subtitle_fontsize_mobile }}px;
      margin-top: 12px;
    }

    .st_related-products--{{ section.id }} .st_related-products-section {
      padding: 30px 15px 30px;
    }

    .st_related-products--{{ section.id }} .st_related-products-header {
      margin-bottom: 30px;
      padding-inline: 10px;
    }
  }

  /* Hide swiper on desktop if 4 or fewer products */
  @media (min-width: 1001px) {
    .st_related-products--{{ section.id }} .st_related-products-swiper.hide-desktop {
      display: none;
    }

    .st_related-products--{{ section.id }} .st_related-products-grid.hide-desktop {
      display: none;
    }

    .st_related-products--{{ section.id }} .st_related-products-swiper.show-desktop {
      display: block;
    }
  }
</style>

{%- liquid
  assign product_limit = section.settings.product_limit
  assign total_products = 0

  if section.settings.product_source == 'collection'
    if section.settings.collection != blank
      assign products_to_show = section.settings.collection.products
      assign total_products = products_to_show.size
      if total_products > product_limit
        assign total_products = product_limit
      endif
    else
      assign products_to_show = blank
    endif
  else
    assign products_to_show = blank
  endif
-%}

<div class="st_related-products--{{ section.id }} st_wrapper st_check-section--{{ section.id }}"
     data-section-id="{{ section.id }}"
     data-product-order="{{ section.settings.product_order }}"
     data-product-limit="{{ product_limit }}">
  <div class="st_related-products-section">
    <div class="st_related-products-container">
      <!-- Header -->
      {% if section.settings.section_title != blank %}
        <div class="st_related-products-header">
          <div class="st_related-products-title">
            {{ section.settings.section_title | replace: '[', '<span class="st_related-products-highlight">' | replace: ']', '</span>' }}
          </div>
          {% if section.settings.show_subtitle and section.settings.section_subtitle != blank %}
            <div class="st_related-products-subtitle">{{ section.settings.section_subtitle }}</div>
          {% endif %}
        </div>
      {% endif %}

      <!-- Products Swiper (Collection or API) -->
      {% if section.settings.product_source == 'collection' %}
        {%- assign products_list = section.settings.collection.products -%}
        {%- assign swiper_id = 'relatedProductsSwiper' -%}

        {% if products_list != blank %}
          <div class="st_related-products-swiper">
            <div class="swiper" id="{{ swiper_id }}{{ section.id }}">
              <div class="swiper-wrapper">
                {% for product in products_list limit: product_limit %}
                  <div class="swiper-slide">
                    <a href="{{ product.url }}" class="st_related-product-card{% if product.images[1] %} has-hover-image{% endif %}">
                      <div class="st_related-product-image-wrapper">
                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 600 }}"
                            alt="{{ product.title | escape }}"
                            class="st_related-product-image main-image"
                            loading="lazy"
                          >
                        {% endif %}

                        {% if product.images[1] %}
                          <img
                            src="{{ product.images[1] | image_url: width: 600 }}"
                            alt="{{ product.title | escape }}"
                            class="st_related-product-image hover-image"
                            loading="lazy"
                          >
                        {% endif %}
                      </div>

                      <div class="st_related-product-info">
                        <h3 class="st_related-product-title">{{ product.title }}</h3>
                        <div class="st_related-product-price">
                          {{ product.price | money }}
                          {% if product.compare_at_price > product.price %}
                            <span class="compare-at-price">{{ product.compare_at_price | money }}</span>
                            {% if section.settings.enable_sale_badge %}
                              {%- assign savings = product.compare_at_price | minus: product.price -%}
                              {%- assign savings_percent = savings | times: 100 | divided_by: product.compare_at_price -%}
                              <span class="st_sale-badge">
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8.575 4.649a3.75 3.75 0 0 1 2.7-1.149h1.975a3.25 3.25 0 0 1 3.25 3.25v2.187a3.25 3.25 0 0 1-.996 2.34l-4.747 4.572a2.5 2.5 0 0 1-3.502-.033l-2.898-2.898a2.75 2.75 0 0 1-.036-3.852l4.254-4.417Zm4.425 3.351a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/>
                              </svg>
                              <span>
                                {{ section.settings.badge_text }}
                                {% if section.settings.badge_show_amount_in_euro %}
                                  {{ savings | money }}
                                {% else %}
                                  {{ savings_percent }}%
                                {% endif %}
                              </span>
                              </span>
                            {% endif %}
                          {% endif %}
                        </div>
                      </div>
                    </a>
                  </div>
                {% endfor %}
              </div>

              <!-- Navigation Buttons -->
              <div class="swiper-button-next">
                <!-- keep div from being :empty -->
              </div>
              <div class="swiper-button-prev">
                <!-- keep div from being :empty -->
              </div>
            </div>
          </div>
        {% endif %}

      {% elsif section.settings.product_source == 'api' %}
        <!-- API Products: Always render wrapper, content loaded via JS -->
        <div class="st_related-products-swiper product-recommendations" data-product-id="{{ product.id }}">
          <div class="swiper" id="apiProductsSwiper{{ section.id }}">
            <div class="swiper-wrapper">
              {%- if recommendations.performed and recommendations.products_count > 0 -%}
                {% for product in recommendations.products limit: product_limit %}
                  <div class="swiper-slide">
                    <a href="{{ product.url }}" class="st_related-product-card{% if product.images[1] %} has-hover-image{% endif %}">
                      <div class="st_related-product-image-wrapper">
                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 600 }}"
                            alt="{{ product.title | escape }}"
                            class="st_related-product-image main-image"
                            loading="lazy"
                          >
                        {% endif %}

                        {% if product.images[1] %}
                          <img
                            src="{{ product.images[1] | image_url: width: 600 }}"
                            alt="{{ product.title | escape }}"
                            class="st_related-product-image hover-image"
                            loading="lazy"
                          >
                        {% endif %}
                      </div>

                      <div class="st_related-product-info">
                        <h3 class="st_related-product-title">{{ product.title }}</h3>
                        <div class="st_related-product-price">
                          {{ product.price | money }}
                          {% if product.compare_at_price > product.price %}
                            <span class="compare-at-price">{{ product.compare_at_price | money }}</span>
                            {% if section.settings.enable_sale_badge %}
                              {%- assign savings = product.compare_at_price | minus: product.price -%}
                              {%- assign savings_percent = savings | times: 100 | divided_by: product.compare_at_price -%}
                              <span class="st_sale-badge">
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8.575 4.649a3.75 3.75 0 0 1 2.7-1.149h1.975a3.25 3.25 0 0 1 3.25 3.25v2.187a3.25 3.25 0 0 1-.996 2.34l-4.747 4.572a2.5 2.5 0 0 1-3.502-.033l-2.898-2.898a2.75 2.75 0 0 1-.036-3.852l4.254-4.417Zm4.425 3.351a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/>
                              </svg>
                              <span>
                                {{ section.settings.badge_text }}
                                {% if section.settings.badge_show_amount_in_euro %}
                                  {{ savings | money }}
                                {% else %}
                                  {{ savings_percent }}%
                                {% endif %}
                              </span>
                              </span>
                            {% endif %}
                          {% endif %}
                        </div>
                      </div>
                    </a>
                  </div>
                {% endfor %}
              {%- endif -%}
            </div>

            <!-- Navigation Buttons -->
            <div class="swiper-button-next">
              <!-- keep div from being :empty -->
            </div>
            <div class="swiper-button-prev">
              <!-- keep div from being :empty -->
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const productOrder = '{{ section.settings.product_order }}';
    const productSource = '{{ section.settings.product_source }}';
    const productLimit = {{ section.settings.product_limit }};
    const productGap = {{ section.settings.product_gap }};

    // Store original order
    let originalGridOrder = null;
    let originalSwiperOrder = null;

    // Fisher-Yates shuffle algorithm
    function shuffleArray(array) {
      for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
      }
      return array;
    }

    // Handle product ordering (random or default)
    function handleProductOrder() {
      if (productSource !== 'collection') return;

      const gridContainer = document.getElementById('productsGrid' + sectionId);
      const swiperContainer = document.querySelector('#relatedProductsSwiper' + sectionId + ' .swiper-wrapper');

      // Store original order if not already stored
      if (!originalGridOrder && gridContainer) {
        originalGridOrder = Array.from(gridContainer.children);
      }
      if (!originalSwiperOrder && swiperContainer) {
        originalSwiperOrder = Array.from(swiperContainer.children);
      }

      if (productOrder === 'random') {
        // Randomize products
        if (gridContainer && originalGridOrder) {
          const shuffled = shuffleArray([...originalGridOrder]);
          gridContainer.innerHTML = '';
          shuffled.forEach(card => gridContainer.appendChild(card));
        }

        if (swiperContainer && originalSwiperOrder) {
          const shuffled = shuffleArray([...originalSwiperOrder]);
          swiperContainer.innerHTML = '';
          shuffled.forEach(slide => swiperContainer.appendChild(slide));
        }
      } else {
        // Restore original order
        if (gridContainer && originalGridOrder) {
          gridContainer.innerHTML = '';
          originalGridOrder.forEach(card => gridContainer.appendChild(card));
        }

        if (swiperContainer && originalSwiperOrder) {
          swiperContainer.innerHTML = '';
          originalSwiperOrder.forEach(slide => swiperContainer.appendChild(slide));
        }
      }
    }

    // Load API recommendations using section rendering
    function loadApiRecommendations() {
      if (productSource !== 'api') return;

      const wrapper = document.querySelector('.st_related-products--' + sectionId + ' .product-recommendations');
      if (!wrapper) return;

      const productId = wrapper.getAttribute('data-product-id');
      if (!productId) return;

      const url = window.Shopify.routes.root + 'recommendations/products?product_id=' + productId + '&section_id=' + sectionId + '&limit=' + productLimit + '&intent=related';

      fetch(url)
        .then(response => response.text())
        .then(html => {
          const tempDiv = document.createElement('div');
          tempDiv.innerHTML = html;
          const fetchedRecommendations = tempDiv.querySelector('.product-recommendations .swiper');

          if (fetchedRecommendations && fetchedRecommendations.innerHTML.trim().length) {
            const currentSwiper = wrapper.querySelector('.swiper');
            if (currentSwiper) {
              currentSwiper.innerHTML = fetchedRecommendations.innerHTML;
            }

            // Initialize API swiper after content is loaded
              const apiSwiper = document.querySelector('#apiProductsSwiper' + sectionId);
              if (apiSwiper) {
                // Destroy existing swiper instance if it exists
                if (apiSwiper.swiper) {
                  apiSwiper.swiper.destroy(true, true);
                }

                // Initialize new swiper
                new Swiper('#apiProductsSwiper' + sectionId, {
                  slidesPerView: 'auto',
                  grabCursor: true,
                  spaceBetween: productGap,
                  navigation: {
                    nextEl: '#apiProductsSwiper' + sectionId + ' .swiper-button-next',
                    prevEl: '#apiProductsSwiper' + sectionId + ' .swiper-button-prev',
                  },
                });
              }
          }
        })
        .catch(error => console.error('Error loading recommendations:', error));
    }

    // Initialize Swipers
    function initSwiper() {
      const collectionSwiper = document.querySelector('#relatedProductsSwiper' + sectionId);

      if (collectionSwiper && !collectionSwiper.swiper) {
        new Swiper('#relatedProductsSwiper' + sectionId, {
          slidesPerView: 'auto',
          grabCursor: true,
          spaceBetween: productGap,
          navigation: {
            nextEl: '#relatedProductsSwiper' + sectionId + ' .swiper-button-next',
            prevEl: '#relatedProductsSwiper' + sectionId + ' .swiper-button-prev',
          },
        });
      }

      /*
        Der API-Swiper wurde bisher AUSSCHLIESSLICH im Erfolgs-Callback von
        loadApiRecommendations() initialisiert. Liefert der Recommendations-
        Endpunkt nichts (leere Antwort, Fehler, Shop ohne Empfehlungen), lief
        `new Swiper()` nie: die serverseitig gerenderten Karten standen dann
        ohne `spaceBetween` direkt aneinander, ohne Abstand und ohne
        funktionierende Pfeile.

        Sind bereits Slides im DOM, wird hier initialisiert. Der Callback
        ersetzt danach nur den Inhalt und initialisiert neu.
      */
      const apiSwiper = document.querySelector('#apiProductsSwiper' + sectionId);
      if (apiSwiper && !apiSwiper.swiper && apiSwiper.querySelector('.swiper-slide')) {
        new Swiper('#apiProductsSwiper' + sectionId, {
          slidesPerView: 'auto',
          grabCursor: true,
          spaceBetween: productGap,
          navigation: {
            nextEl: '#apiProductsSwiper' + sectionId + ' .swiper-button-next',
            prevEl: '#apiProductsSwiper' + sectionId + ' .swiper-button-prev',
          },
        });
      }
    }

    // Main initialization
    function init() {
      handleProductOrder();
      initSwiper();
      loadApiRecommendations();
    }

    // Shopify theme editor events
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === sectionId) {
        setTimeout(init, 100);
      }
    });

    // Initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

