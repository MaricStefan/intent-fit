<script
  src="https://app.sternify.com/verifier.js?v={{ 'now' | date: '%s' }}"
  data-section-id="{{ section.id }}"
  defer></script>

<div
  id="st_not-found--{{ section.id }}"
  class="st_not-found"
  style="display: none;"></div>

{% style %}
  /* BFC gegen Margin-Collapsing mit Nachbar-Sections (Standard Regel 3) */
  #shopify-section-{{ section.id }} {
    display: flow-root;
    background-color: {{ section.settings.section_background_color }};
    padding-top: {{ section.settings.margin_top }}px;
    padding-bottom: {{ section.settings.margin_bottom }}px;
  }

  {%- assign header_title_font = section.settings.header_title_font -%}
  {%- assign header_title_font_bold = header_title_font | font_modify: 'weight', 'bold' -%}
  {%- assign header_title_font_italic = header_title_font | font_modify: 'style', 'italic' -%}
  {%- assign header_title_font_bold_italic = header_title_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' -%}
  {%- assign header_subtitle_font = section.settings.header_subtitle_font -%}
  {%- assign header_subtitle_font_bold = header_subtitle_font | font_modify: 'weight', 'bold' -%}
  {%- assign header_subtitle_font_italic = header_subtitle_font | font_modify: 'style', 'italic' -%}
  {%- assign header_subtitle_font_bold_italic = header_subtitle_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' -%}
  {%- assign stat_font = section.settings.stat_font -%}
  {%- assign stat_title_font = section.settings.stat_title_font -%}
  {%- assign stat_subtitle_font = section.settings.stat_subtitle_font -%}
  {%- assign footer_text_font = section.settings.footer_text_font -%}

  {{ header_title_font | font_face: font_display: 'swap' }}
  {%- if header_title_font_bold != header_title_font -%}{{ header_title_font_bold | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if header_title_font_italic != header_title_font -%}{{ header_title_font_italic | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if header_title_font_bold_italic != header_title_font -%}{{ header_title_font_bold_italic | font_face: font_display: 'swap' }}{%- endif -%}

  {{ header_subtitle_font | font_face: font_display: 'swap' }}
  {%- if header_subtitle_font_bold != header_subtitle_font -%}{{ header_subtitle_font_bold | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if header_subtitle_font_italic != header_subtitle_font -%}{{ header_subtitle_font_italic | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if header_subtitle_font_bold_italic != header_subtitle_font -%}{{ header_subtitle_font_bold_italic | font_face: font_display: 'swap' }}{%- endif -%}
  
  {{ stat_font | font_face }}
  {{ stat_title_font | font_face }}
  {{ stat_subtitle_font | font_face }}
  {{ footer_text_font | font_face }}

  /* --- Section Wrapper --- */
    .st_swi-wrapper--{{ section.id }} {
      overflow: hidden;
      padding-inline: 0;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section {
      width: 100%;
      {% if section.settings.desktop_card_layout %}
      {% if section.settings.bg_color_mode == 'solid' %}
        background-color: {{ section.settings.section_bg_color_solid }};
      {% else %}
        background: {{ section.settings.section_bg_color_gradient }};
      {% endif %}
      {% endif %}
      padding: 40px;
      border-radius: 0;
      max-width: 100%;
      overflow: hidden;
      box-sizing: border-box;
    }
  /* --- */

  /* ── Exclude card layout from mobile ── */
    @media screen and (min-width: 768px) {
      .st_swi-wrapper--{{ section.id }} {
        {% if section.settings.desktop_card_layout %}
          padding-inline: 45px;
          margin: 0 auto;
        {% elsif section.settings.full_width %}
          padding-inline: 0;
        {% else %}
          padding-inline: 0;
          margin: 0 auto;
        {% endif %}
      }

      .st_swi-wrapper--{{ section.id }}
      .st_swi-section {
        {% if section.settings.desktop_card_layout %}
          max-width: {{ section.settings.max_width }}px;
          margin-left: auto;
          margin-right: auto;
          border-radius: 12px;
        {% elsif section.settings.full_width %}
          border-radius: 0;
          max-width: 100%;
        {% else %}
          max-width: {{ section.settings.max_width }}px;
          margin-left: auto;
          margin-right: auto;
          border-radius: 0;
        {% endif %}
      }
    }
  /* --- */

  /* ── Counter st_reset.css to allow richtext styling ── */
    .st_swi-wrapper--{{ section.id }} :is(strong, b),
    .st_swi-wrapper--{{ section.id }} :is(strong, b) * {
      font-weight: bold !important;
      font-family: inherit;
      color: inherit;
      font-style: inherit;
    }

    .st_swi-wrapper--{{ section.id }} :is(em, i),
    .st_swi-wrapper--{{ section.id }} :is(em, i) * {
      font-style: italic !important;
      font-family: inherit;
      color: inherit;
      font-weight: inherit;
    }

    .st_swi-wrapper--{{ section.id }} span {
      font-size: inherit;
      font-family: inherit;
      color: inherit;
      font-style: inherit;
      font-weight: inherit;
    }
  /* --- */

  /* ── Inner grid layout (desktop) ── */
    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner {
      display: grid;
      grid-template-columns: {% if section.settings.desktop_image_position == 'left' %}{{ section.settings.image_size }}% 1fr{% else %}1fr {{ section.settings.image_size }}%{% endif %};
      grid-template-rows: auto auto auto;
      column-gap: 40px;
      align-items: start;
    }

    {% assign text_col = 1 %}
    {% assign img_col = 2 %}
    {% if section.settings.desktop_image_position == 'left' %}
      {% assign text_col = 2 %}
      {% assign img_col = 1 %}
    {% endif %}

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-header {
      grid-column: {{ text_col }};
      grid-row: 1;
      margin-bottom: 20px;
      text-align: {{ section.settings.header_alignment }};
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-stats {
      grid-column: {{ text_col }};
      grid-row: 2;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-footer {
      grid-column: {{ text_col }};
      grid-row: 3;
      margin-top: 16px;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-image {
      grid-column: {{ img_col }};
      grid-row: 1 / -1;
    }
  /* --- */

  /* ── Section Header ── */
    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-header .st_swi-section-inner-header-title {
      font-family: {{ header_title_font.family }}, {{ header_title_font.fallback_families }};
      font-weight: {{ header_title_font.weight }};
      font-style: {{ header_title_font.style }};
      font-size: {{ section.settings.header_title_fontsize_desktop }}px;
      color: {{ section.settings.header_title_color }} !important;
      margin: 0 0 8px;
      display: block;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-header .st_swi-section-inner-header-title .st_swi-section-inner-header-title-highlight {
      {% if section.settings.header_title_highlight_mode == 'gradient' %}
        background: {{ section.settings.header_title_highlight_color_gradient }};
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      {% else %}
        color: {{ section.settings.header_title_highlight_color_solid }} !important;
      {% endif %}
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-header .st_swi-section-inner-header-subtitle {
      font-family: {{ header_subtitle_font.family }}, {{ header_subtitle_font.fallback_families }};
      font-weight: {{ header_subtitle_font.weight }};
      font-style: {{ header_subtitle_font.style }};
      font-size: {{ section.settings.header_subtitle_fontsize_desktop }}px;
      color: {{ section.settings.header_subtitle_color }} !important;
      /* Section standard: 10px under the section title. */
      margin: 10px 0 0;
      display: block;
    }
  /* --- */

  /* ── Image ── */
    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: {{ section.settings.image_border_radius }}px;
      display: block;
    }
  /* --- */

  /* ── Stats list ── */
    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-stats .st_swi-section-inner-stats-stat {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px 0;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-stats .st_swi-section-inner-stats-stat:not(:last-child) {
      {% if section.settings.stat_divider == false %}
        border-bottom: none !important;
        padding-bottom: 0 !important;
      {% else %}
        border-bottom: 1px solid {{ section.settings.stat_divider_color }} !important;
      {% endif %}
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-stats .st_swi-section-inner-stats-stat .st_swi-section-inner-stats-stat-number {
      font-family: {{ stat_font.family }}, {{ stat_font.fallback_families }};
      font-weight: {{ stat_font.weight }};
      font-style: {{ stat_font.style }};
      font-size: {{ section.settings.stat_fontsize_desktop }}px;
      {% if section.settings.stat_color_mode == 'gradient' %}
        background: {{ section.settings.stat_color_gradient }};
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      {% else %}
        color: {{ section.settings.stat_color_solid }} !important;
      {% endif %}
      flex-shrink: 0;
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.45s ease-out, transform 0.45s ease-out;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-stats .st_swi-section-inner-stats-stat .st_swi-section-inner-stats-stat-number.st_swi-stat-number--visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .st_swi-wrapper--{{ section.id }}
      .st_swi-section-inner-stats .st_swi-section-inner-stats-stat .st_swi-section-inner-stats-stat-number {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-stats .st_swi-section-inner-stats-stat .st_swi-section-inner-stats-stat-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-stats .st_swi-section-inner-stats-stat .st_swi-section-inner-stats-stat-title {
      font-family: {{ stat_title_font.family }}, {{ stat_title_font.fallback_families }};
      font-weight: {{ stat_title_font.weight }};
      font-style: {{ stat_title_font.style }};
      font-size: {{ section.settings.stat_title_fontsize_desktop }}px;
      color: {{ section.settings.stat_title_color }} !important;
      margin: 0;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-stats .st_swi-section-inner-stats-stat .st_swi-section-inner-stats-stat-subtitle {
      font-family: {{ stat_subtitle_font.family }}, {{ stat_subtitle_font.fallback_families }};
      font-weight: {{ stat_subtitle_font.weight }};
      font-style: {{ stat_subtitle_font.style }};
      font-size: {{ section.settings.stat_subtitle_fontsize_desktop }}px;
      color: {{ section.settings.stat_subtitle_color }} !important;
      margin: 0;
    }
  /* --- */

  /* ── Footer ── */
    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-footer .st_swi-section-inner-footer-box {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      border: 1.5px dashed {{ section.settings.footer_border_color }};
      border-radius: 8px;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-footer .st_swi-section-inner-footer-box-icon {
      flex-shrink: 0;
      width: {{ section.settings.footer_icon_size }}px;
      height: {{ section.settings.footer_icon_size }}px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-footer .st_swi-section-inner-footer-box-icon img,
    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-footer .st_swi-section-inner-footer-box-icon svg {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-footer .st_swi-section-inner-footer-box-icon svg {
      fill: {{ section.settings.footer_text_color }};
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-footer .st_swi-section-inner-footer-box-text {
      font-family: {{ footer_text_font.family }}, {{ footer_text_font.fallback_families }};
      font-weight: {{ footer_text_font.weight }};
      font-style: {{ footer_text_font.style }};
      font-size: {{ section.settings.footer_text_fontsize_desktop }}px;
      color: {{ section.settings.footer_text_color }} !important;
      margin: 0;
    }
  /* --- */

  /* 1. Tablet adjustments (1200px) */
  @media (max-width: 1200px) {
    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-header .st_swi-section-inner-header-title {
      font-size: {{ section.settings.header_title_fontsize_mobile }}px;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-header .st_swi-section-inner-header-subtitle {
      font-size: {{ section.settings.header_subtitle_fontsize_mobile }}px;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-stats .st_swi-section-inner-stats-stat .st_swi-section-inner-stats-stat-number {
      font-size: {{ section.settings.stat_fontsize_mobile }}px;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-stats .st_swi-section-inner-stats-stat .st_swi-section-inner-stats-stat-title {
      font-size: {{ section.settings.stat_title_fontsize_mobile }}px;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-stats .st_swi-section-inner-stats-stat .st_swi-section-inner-stats-stat-subtitle {
      font-size: {{ section.settings.stat_subtitle_fontsize_mobile }}px;
    }

    .st_swi-wrapper--{{ section.id }}
    .st_swi-section-inner-footer .st_swi-section-inner-footer-box-text {
      font-size: {{ section.settings.footer_text_fontsize_mobile }}px;
    }
  }

  /* 2. Mobile layout changes (1000px) */
  @media (max-width: 1000px) {
    ;
    /* Major layout restructuring for mobile */
  }

  /* ── Mobile ── */
    @media (max-width: 768px) {
      .st_swi-wrapper--{{ section.id }}
      .st_swi-section {
        padding: 30px 20px;
      }

      .st_swi-wrapper--{{ section.id }}
      .st_swi-section-inner {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: center;
      }

      .st_swi-wrapper--{{ section.id }} .st_swi-section-inner-header {
        order: 1;
        margin-bottom: 0;
      }
      .st_swi-wrapper--{{ section.id }} .st_swi-section-inner-image {
        order: 2;
        width: 100%;
      }
      .st_swi-wrapper--{{ section.id }} .st_swi-section-inner-stats {
        order: 3;
      }
      .st_swi-wrapper--{{ section.id }} .st_swi-section-inner-stats .st_swi-section-inner-stats-stat {
        padding: 12px 0;
      }
      .st_swi-wrapper--{{ section.id }} .st_swi-section-inner-footer {
        order: 4;
        margin-top: 0;
      }

      .st_swi-wrapper--{{ section.id }}
      .st_swi-section-inner-header .st_swi-section-inner-header-title {
        font-size: {{ section.settings.header_title_fontsize_mobile }}px;
      }

      .st_swi-wrapper--{{ section.id }}
      .st_swi-section-inner-header .st_swi-section-inner-header-subtitle {
        font-size: {{ section.settings.header_subtitle_fontsize_mobile }}px;
      }

      .st_swi-wrapper--{{ section.id }}
      .st_swi-section-inner-stats .st_swi-section-inner-stats-stat .st_swi-section-inner-stats-stat-number {
        font-size: {{ section.settings.stat_fontsize_mobile }}px;
      }

      .st_swi-wrapper--{{ section.id }}
      .st_swi-section-inner-stats .st_swi-section-inner-stats-stat .st_swi-section-inner-stats-stat-title {
        font-size: {{ section.settings.stat_title_fontsize_mobile }}px;
      }

      .st_swi-wrapper--{{ section.id }}
      .st_swi-section-inner-stats .st_swi-section-inner-stats-stat .st_swi-section-inner-stats-stat-subtitle {
        font-size: {{ section.settings.stat_subtitle_fontsize_mobile }}px;
      }

      .st_swi-wrapper--{{ section.id }}
      .st_swi-section-inner-footer .st_swi-section-inner-footer-box-text {
        font-size: {{ section.settings.footer_text_fontsize_mobile }}px;
      }
    }
  /* --- */
{% endstyle %}

<div class="st_swi-wrapper--{{ section.id }} st_wrapper st_check-section--{{ section.id }}">
  <div class="st_swi-section">
    <div class="st_swi-section-inner">

      {% if section.settings.header_title != blank or section.settings.header_subtitle != blank %}
        <div class="st_swi-section-inner-header">
          {% if section.settings.header_title != blank %}
            <div class="st_swi-section-inner-header-title">
              {{ section.settings.header_title | replace: '[', '<span class="st_swi-section-inner-header-title-highlight">' | replace: ']', '</span>' }}
            </div>
          {% endif %}
          {% if section.settings.header_subtitle != blank %}
            <div class="st_swi-section-inner-header-subtitle">{{ section.settings.header_subtitle }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.image != blank %}
        <div class="st_swi-section-inner-image">
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}
        </div>
      {% elsif section.settings.image_demo_url != blank %}
        <div class="st_swi-section-inner-image">
          <img src="{{ section.settings.image_demo_url }}" loading="lazy" alt="">
        </div>
      {% else %}
        <div class="st_swi-section-inner-image">
          <img src="https://cdn.shopify.com/s/files/1/0865/0588/1634/files/Sternify_Black_Skin_Care.png?v=1772104938" width="1000" height="1000" alt="Sternify Skin Care" loading="lazy">
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="st_swi-section-inner-stats">
          {% for block in section.blocks %}
            <div class="st_swi-section-inner-stats-stat" {{ block.shopify_attributes }}>
              {% if block.settings.stat_text != blank %}
                <div class="st_swi-section-inner-stats-stat-number">{{ block.settings.stat_text }}</div>
              {% endif %}
              {% if block.settings.stat_title != blank or block.settings.stat_subtitle != blank %}
                <div class="st_swi-section-inner-stats-stat-info">
                  {% if block.settings.stat_title != blank %}
                    <div class="st_swi-section-inner-stats-stat-title">{{ block.settings.stat_title }}</div>
                  {% endif %}
                  {% if block.settings.stat_subtitle != blank %}
                    <div class="st_swi-section-inner-stats-stat-subtitle">{{ block.settings.stat_subtitle }}</div>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.footer_text != blank and section.settings.show_footer %}
        <div class="st_swi-section-inner-footer">
          <div class="st_swi-section-inner-footer-box">
            {% if section.settings.footer_icon != blank %}
              <div class="st_swi-section-inner-footer-box-icon">
                {{ section.settings.footer_icon | image_url: width: 64 | image_tag: loading: 'lazy', alt: 'Footer icon' }}
              </div>
            {% elsif section.settings.footer_icon_demo_url != blank %}
              <div class="st_swi-section-inner-footer-box-icon">
                <img src="{{ section.settings.footer_icon_demo_url }}" loading="lazy" alt="Footer icon">
              </div>
            {% else %}
              <div class="st_swi-section-inner-footer-box-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                </svg>
              </div>
            {% endif %}
            <div class="st_swi-section-inner-footer-box-text">{{ section.settings.footer_text }}</div>
          </div>
        </div>
      {% endif %}

    </div>
  </div>
</div>

<script>
  (function() {
    function initStatNumberScrollAnimation() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const section = document.querySelector('.st_swi-wrapper--{{ section.id }}');
      if (!section) return;

      const statNumbers = section.querySelectorAll('.st_swi-section-inner-stats-stat-number');
      if (statNumbers.length === 0) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('st_swi-stat-number--visible');
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });

      statNumbers.forEach(el => observer.observe(el));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStatNumberScrollAnimation);
    } else {
      initStatNumberScrollAnimation();
    }

    document.addEventListener('shopify:section:load', (e) => {
      if (e.detail?.sectionId === '{{ section.id }}') initStatNumberScrollAnimation();
    });
  })();
</script>

{% schema %}
  {
    "name": "💫: Stats with Image",
    "class": "swi-section",
    "tag": "section",
    "max_blocks": 5,
    "settings": [
      {
        "type": "header",
        "content": "Important",
        "info": "Please ensure that Sternify [App Extensions](https://www.sternify.com/app-extentions) are activated."
      },
      {
        "type": "header",
        "content": "Section Layout"
      },
      {
        "type": "range",
        "id": "margin_top",
        "label": "Top Margin",
        "min": 0,
        "max": 150,
        "step": 5,
        "default": 50,
        "unit": "px"
