{% assign mac_has_video = false %}
{% if section.settings.video_file != blank or section.settings.video_file_demo_url != blank %}
  {% assign mac_has_video = true %}
{% endif %}
{% if section.settings.video_with_sound and mac_has_video %}
<script>
  (function() {
    const wrapper = document.querySelector('.st_media-and-content-video-wrapper--{{ section.id }}');
    if (!wrapper) return;

    const video = wrapper.querySelector('video');
    const playButton = wrapper.querySelector('[data-play-button]');
    const playPauseBtn = wrapper.querySelector('[data-play-pause-btn]');
    const muteBtn = wrapper.querySelector('[data-mute-btn]');
    const volumeSlider = wrapper.querySelector('[data-volume-slider]');
    const playIcon = wrapper.querySelector('[data-play-icon]');
    const pauseIcon = wrapper.querySelector('[data-pause-icon]');
    const volumeIcon = wrapper.querySelector('[data-volume-icon]');
    const mutedIcon = wrapper.querySelector('[data-muted-icon]');

    if (!video || !playButton) return;

    function playVideo() {
      video.play();
      wrapper.classList.add('is-playing');
      wrapper.classList.add('has-started');
    }

    function pauseVideo() {
      video.pause();
    }

    function togglePlayPause() {
      if (video.paused) {
        playVideo();
      } else {
        pauseVideo();
      }
    }

    function updatePlayPauseIcons() {
      if (video.paused) {
        playIcon.style.display = 'block';
        pauseIcon.style.display = 'none';
      } else {
        playIcon.style.display = 'none';
        pauseIcon.style.display = 'block';
      }
    }

    function toggleMute() {
      video.muted = !video.muted;
      updateVolumeIcons();
      if (volumeSlider) {
        volumeSlider.value = video.muted ? 0 : video.volume;
      }
    }

    function updateVolumeIcons() {
      if (video.muted || video.volume === 0) {
        volumeIcon.style.display = 'none';
        mutedIcon.style.display = 'block';
      } else {
        volumeIcon.style.display = 'block';
        mutedIcon.style.display = 'none';
      }
    }

    function handleVolumeChange(e) {
      const value = parseFloat(e.target.value);
      video.volume = value;
      video.muted = value === 0;
      updateVolumeIcons();
    }

    playButton.addEventListener('click', playVideo);

    if (playPauseBtn) {
      playPauseBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        togglePlayPause();
      });
    }

    if (muteBtn) {
      muteBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        toggleMute();
      });
    }

    if (volumeSlider) {
      volumeSlider.addEventListener('input', handleVolumeChange);
      volumeSlider.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    }

    video.addEventListener('pause', function() {
      updatePlayPauseIcons();
      if (video.currentTime > 0 && !video.ended) {
        wrapper.classList.remove('is-playing');
      }
    });

    video.addEventListener('play', function() {
      updatePlayPauseIcons();
      wrapper.classList.add('is-playing');
    });

    video.addEventListener('ended', function() {
      updatePlayPauseIcons();
      wrapper.classList.remove('is-playing');
    });

    video.addEventListener('volumechange', updateVolumeIcons);

    // Click on video to toggle play/pause
    video.addEventListener('click', togglePlayPause);
  })();
</script>
{% endif %}

{% comment %} Lazy autoplay: only load and play silent videos when they scroll into view {% endcomment %}
<script>
  (function() {
    var wrapper = document.querySelector('.st_check-section--{{ section.id }}');
    if (!wrapper) return;
    var video = wrapper.querySelector('video.st_mac-lazy-video');
    if (!video) return;

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var v = entry.target;
            if (v.preload === 'none') {
              v.preload = 'auto';
              v.load();
            }
            v.play().catch(function() {});
          } else {
            entry.target.pause();
          }
        });
      }, { rootMargin: '200px 0px' });
      observer.observe(video);
    } else {
      video.preload = 'auto';
      video.load();
      video.play().catch(function() {});
    }
  })();
</script>

